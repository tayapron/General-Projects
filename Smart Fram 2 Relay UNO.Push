#include <DHT.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>

// ================= PIN CONFIG =================
#define DHTPIN 5
#define DHTTYPE DHT11

#define RELAY_FAN 8
#define RELAY_PUMP 7

#define SOIL_PIN A0

#define BTN_FAN 4
#define BTN_PUMP 3

// ================= LCD & DHT =================
LiquidCrystal_I2C lcd(0x27, 16, 2);
DHT dht(DHTPIN, DHTTYPE);

// ================= STATE & BUTTONS =================
bool fanState = false;
bool pumpState = false;

bool lastBtnFanState = HIGH;
bool lastBtnPumpState = HIGH;

// จับเวลาสำหรับ Debounce ปุ่มกด
unsigned long lastDebounceFanTime = 0;
unsigned long lastDebouncePumpTime = 0;
const unsigned long DEBOUNCE_DELAY = 50;

// จับเวลาสำหรับอ่านเซนเซอร์ทุก 2 วินาที
unsigned long lastSensorTime = 0;
const unsigned long SENSOR_INTERVAL = 2000;

float currentTemp = 0.0;
bool isTempError = true;
int currentSoil = 0;

void setup() {
  Serial.begin(9600);

  // กำหนดขารีเลย์ ( Active LOW: สั่ง HIGH เพื่อปิดไว้ก่อนในตอนเริ่ม )
  // **หมายเหตุ:** หากรีเลย์ของคุณเป็น Active HIGH ให้เปลี่ยน HIGH เป็น LOW
  digitalWrite(RELAY_FAN, HIGH);
  digitalWrite(RELAY_PUMP, HIGH);
  pinMode(RELAY_FAN, OUTPUT);
  pinMode(RELAY_PUMP, OUTPUT);

  // กำหนดขาปุ่มกด (ใช้ R-Pullup ภายใน: ขาหนึ่งต่อ Pin อีกขาต่อ GND)
  pinMode(BTN_FAN, INPUT_PULLUP);
  pinMode(BTN_PUMP, INPUT_PULLUP);

  dht.begin();

  lcd.init();
  lcd.backlight();
  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print("Smart Farm");
  lcd.setCursor(0, 1);
  lcd.print("Manual Mode");
  delay(2000);
  lcd.clear();

  updateLCDDisplay();
}

void loop() {
  unsigned long currentMillis = millis();

  // =================================================
  // 1. เช็คปุ่มกดพัดลม (กด 1 ครั้งสลับ ON/OFF)
  // =================================================
  bool readingFan = digitalRead(BTN_FAN);
  if (readingFan != lastBtnFanState) {
    lastDebounceFanTime = currentMillis;
  }
  if ((currentMillis - lastDebounceFanTime) > DEBOUNCE_DELAY) {
    static bool fanStateNow = HIGH;
    if (readingFan != fanStateNow) {
      fanStateNow = readingFan;
      if (fanStateNow == LOW) {
        fanState = !fanState;
        updateLCDStatusOnly();
      }
    }
  }
  lastBtnFanState = readingFan;

  // =================================================
  // 2. เช็คปุ่มกดปั๊มน้ำ (กด 1 ครั้งสลับ ON/OFF)
  // =================================================
  bool readingPump = digitalRead(BTN_PUMP);
  if (readingPump != lastBtnPumpState) {
    lastDebouncePumpTime = currentMillis;
  }
  if ((currentMillis - lastDebouncePumpTime) > DEBOUNCE_DELAY) {
    static bool pumpStateNow = HIGH;
    if (readingPump != pumpStateNow) {
      pumpStateNow = readingPump;
      if (pumpStateNow == LOW) {
        pumpState = !pumpState;
        updateLCDStatusOnly();
      }
    }
  }
  lastBtnPumpState = readingPump;

  // =================================================
  // 3. สั่งงาน Relay (Active LOW)
  // **หากรีเลย์ทำงานตรงข้าม ให้เปลี่ยน LOW : HIGH เป็น HIGH : LOW**
  // =================================================
  digitalWrite(RELAY_FAN, fanState ? LOW : HIGH);
  digitalWrite(RELAY_PUMP, pumpState ? LOW : HIGH);

  // =================================================
  // 4. อ่านค่าเซนเซอร์ทุก 2 วินาที (Non-blocking)
  // =================================================
  if (currentMillis - lastSensorTime >= SENSOR_INTERVAL) {
    lastSensorTime = currentMillis;

    float t = dht.readTemperature();
    if (isnan(t)) {
      isTempError = true;
    } else {
      isTempError = false;
      currentTemp = t;
    }

    int soilRaw = analogRead(SOIL_PIN);
    currentSoil = constrain(map(soilRaw, 1023, 0, 0, 100), 0, 100);

    updateLCDDisplay();
  }
}

// อัปเดตหน้าจอทั้งหมด
void updateLCDDisplay() {
  lcd.setCursor(0, 0);
  lcd.print("T:");
  if (isTempError) {
    lcd.print("ERR ");
  } else {
    lcd.print(currentTemp, 1);
    lcd.print("C ");
  }

  lcd.print("S:");
  lcd.print(currentSoil);
  lcd.print("%   ");

  updateLCDStatusOnly();
}

// อัปเดตเฉพาะสถานะ F: และ P: ให้ตอบสนองเร็วที่สุด
void updateLCDStatusOnly() {
  lcd.setCursor(0, 1);
  lcd.print("F:");
  lcd.print(fanState ? "ON " : "OFF");
  lcd.print(" P:");
  lcd.print(pumpState ? "ON " : "OFF");
}
