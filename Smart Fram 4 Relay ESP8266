#include <ESP8266WiFi.h>
#include <BlynkSimpleEsp8266.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <Adafruit_SHT31.h>
#include <BH1750.h>

char ssid[] = "Homhuanta_2.4G";
char pass[] = "0877705609";

LiquidCrystal_I2C lcd(0x27, 16, 2); 
Adafruit_SHT31 sht31 = Adafruit_SHT31();
BH1750 lightMeter;

#define SOIL_PIN A0
#define RELAY1 D5
#define RELAY2 D6
#define RELAY3 D7
#define RELAY4 D8

BlynkTimer timer;

// ตัวแปรสถานะโหมด (0 = Manual, 1 = Auto)
bool isAutoMode = false;

// ฟังก์ชันสั่งเปิด/ปิด Relay แบบ Active LOW
void setRelay(int pin, int state) {
  digitalWrite(pin, state ? LOW : HIGH);
}

// ปุ่มเปิด/ปิดโหมด Auto บน Blynk (Pin V8)
BLYNK_WRITE(V8) {
  isAutoMode = param.asInt();
  Serial.print("Mode changed to: ");
  Serial.println(isAutoMode ? "AUTO" : "MANUAL");
}

// ควบคุมแบบ Manual (ทำงานเมื่อ isAutoMode = false)
BLYNK_WRITE(V4) {
  if (!isAutoMode) setRelay(RELAY1, param.asInt());
}

BLYNK_WRITE(V5) {
  if (!isAutoMode) setRelay(RELAY2, param.asInt());
}

BLYNK_WRITE(V6) {
  if (!isAutoMode) setRelay(RELAY3, param.asInt());
}

BLYNK_WRITE(V7) {
  if (!isAutoMode) setRelay(RELAY4, param.asInt());
}

// ฟังก์ชันเงื่อนไขทำงานอัตโนมัติ (Auto Mode)
void autoControl(int soil, float temp, float hum, float lux) {
  if (!isAutoMode) return;

  // 1. คุม Relay 1 ตามความชื้นดิน
  if (soil < 40) {
    setRelay(RELAY1, HIGH);
    Blynk.virtualWrite(V4, 1);
  } else if (soil >= 60) {
    setRelay(RELAY1, LOW);
    Blynk.virtualWrite(V4, 0);
  }

  // 2. คุม Relay 2 ตามอุณหภูมิ (พัดลม)
  if (temp > 35.0) {
    setRelay(RELAY2, HIGH);
    Blynk.virtualWrite(V5, 1);
  } else if (temp <= 32.0) {
    setRelay(RELAY2, LOW);
    Blynk.virtualWrite(V5, 0);
  }

  // 3. คุม Relay 3 ตามความชื้นอากาศ (พ่นหมอก)
  if (hum < 50.0) {
    setRelay(RELAY3, HIGH);
    Blynk.virtualWrite(V6, 1);
  } else if (hum >= 70.0) {
    setRelay(RELAY3, LOW);
    Blynk.virtualWrite(V6, 0);
  }

  // 4. คุม Relay 4 ตามระดับแสง (ไฟปลูกต้นไม้/หลอดไฟ)
  if (lux < 200.0) {
    setRelay(RELAY4, HIGH);
    Blynk.virtualWrite(V7, 1);
  } else if (lux >= 500.0) {
    setRelay(RELAY4, LOW);
    Blynk.virtualWrite(V7, 0);
  }
}

void sendSensorData() {
  int analogSoil = analogRead(SOIL_PIN);
  int soilPercent = map(analogSoil, 1023, 400, 0, 100);
  soilPercent = constrain(soilPercent, 0, 100);

  float temp = sht31.readTemperature();
  float humidity = sht31.readHumidity();
  float lux = lightMeter.readLightLevel();

  // ประมวลผลโหมด Auto
  autoControl(soilPercent, temp, humidity, lux);

  // ส่งข้อมูลเข้า Blynk
  Blynk.virtualWrite(V0, soilPercent);
  Blynk.virtualWrite(V1, temp);
  Blynk.virtualWrite(V2, humidity);
  Blynk.virtualWrite(V3, lux);

  // แสดงผลบนจอ LCD
  lcd.setCursor(0, 0);
  lcd.print("T:"); lcd.print((int)temp); lcd.print("C ");
  lcd.print("H:"); lcd.print((int)humidity); lcd.print("% ");
  lcd.print(isAutoMode ? "A" : "M"); // แสดงสถานะ A=Auto, M=Manual ท้ายบรรทัดแรก

  lcd.setCursor(0, 1);
  lcd.print("S:"); lcd.print(soilPercent); lcd.print("% ");
  lcd.print("L:"); lcd.print((int)lux); lcd.print("lx  ");
}

void setup() {
  Serial.begin(115200);

  // ตั้งค่า Relay เริ่มต้นปิดทั้งหมด (Active LOW: HIGH คือปิด)
  pinMode(RELAY1, OUTPUT); digitalWrite(RELAY1, HIGH);
  pinMode(RELAY2, OUTPUT); digitalWrite(RELAY2, HIGH);
  pinMode(RELAY3, OUTPUT); digitalWrite(RELAY3, HIGH);
  pinMode(RELAY4, OUTPUT); digitalWrite(RELAY4, HIGH);

  Wire.begin(D2, D1);

  lcd.init();
  lcd.backlight();

  if (!sht31.begin(0x44)) {
    Serial.println("SHT3x not found!");
  }
  
  // ระบุ Mode, Address (0x23) และช่องทาง Wire ให้ครบถ้วน
  if (!lightMeter.begin(BH1750::CONTINUOUS_HIGH_RES_MODE, 0x23, &Wire)) {
    Serial.println("BH1750 not found at 0x23!");
    
    // ถ้าไม่เจอที่ 0x23 ให้ลองเช็กที่ 0x5C เผื่อขา ADDR ลอย/ต่อ VCC
    if (!lightMeter.begin(BH1750::CONTINUOUS_HIGH_RES_MODE, 0x5C, &Wire)) {
      Serial.println("BH1750 not found at 0x5C either!");
    } else {
      Serial.println("BH1750 found at 0x5C!");
    }
  } else {
    Serial.println("BH1750 found at 0x23!");
  }

  Blynk.begin(BLYNK_AUTH_TOKEN, ssid, pass);
  timer.setInterval(2000L, sendSensorData);
}

void loop() {
  Blynk.run();
  timer.run();
}
