#define RAIN_ANALOG_PIN A0   // ขา AO ของเซนเซอร์น้ำฝน
#define BUZZER_PIN 7        // ขาส่งสัญญาณออด
#define BUTTON_PIN 5        // ขาปุ่มกดปิดเสียง

const int RAIN_THRESHOLD = 700; // ค่าน้อยกว่า 700 ถือว่าเปียก/ฝนตก

bool isMuted = false;
int lastButtonState = HIGH;
unsigned long lastDebounceTime = 0;
const unsigned long debounceDelay = 50; // หน่วงเวลาป้องกันสัญญาณรบกวน 50ms

void setup() {
  Serial.begin(9600);
  
  pinMode(RAIN_ANALOG_PIN, INPUT);
  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(BUTTON_PIN, INPUT_PULLUP);

  Serial.println("=== ระบบตรวจจับน้ำฝน (กดปุ่มหยุดเสียงทันที) ===");
}

void loop() {
  // 1. อ่านค่าจากเซนเซอร์น้ำฝน
  int rawRainValue = analogRead(RAIN_ANALOG_PIN);
  bool isRaining = (rawRainValue < RAIN_THRESHOLD);

  // 2. อ่านค่าปุ่มกดและปิดเสียงทันที
  int reading = digitalRead(BUTTON_PIN);

  // ถ้ามีการเปลี่ยนแปลงสถานะปุ่มกด ให้เริ่มจับเวลา
  if (reading != lastButtonState) {
    lastDebounceTime = millis();
    lastButtonState = reading; // อัปเดตสถานะปุ่มกดทันที
  }

  // เมื่อพ้นระยะเวลา Debounce และปุ่มถูกกดลง (LOW)
  if ((millis() - lastDebounceTime) > debounceDelay) {
    if (reading == LOW && !isMuted && isRaining) {
      isMuted = true;
      noTone(BUZZER_PIN); // *** สั่งหยุดเสียงออดทันทีทันใดที่ตรงเงื่อนไข ***
      Serial.println("-> กดปุ่ม: ปิดเสียงเตือนทันที!");
    }
  }

  // 3. รีเซ็ตสถานะปิดเสียงอัตโนมัติ เมื่อแผ่นเซนเซอร์แห้งแล้ว
  if (!isRaining) {
    isMuted = false;
  }

  // 4. ควบคุมการส่งเสียงเตือน
  if (isRaining && !isMuted) {
    tone(BUZZER_PIN, 1000); // ส่งเสียงเตือนความถี่ 1000Hz
  } else {
    noTone(BUZZER_PIN);     // หยุดเสียงเมื่อแห้งหรือถูก Mute
  }

  // 5. แสดงผลบน Serial Monitor
  static unsigned long lastLogTime = 0;
  if (millis() - lastLogTime > 500) {
    Serial.print("ค่าความชื้นน้ำฝน (Raw): ");
    Serial.print(rawRainValue);
    Serial.print(" | สถานะ: ");
    Serial.print(isRaining ? "ฝนตก/เปียก [!] " : "ปกติ/แห้ง [OK] ");
    Serial.print(" | ปิดเสียง: ");
    Serial.println(isMuted ? "เปิดอยู่ (Muted)" : "ปิดอยู่");
    
    lastLogTime = millis();
  }
}
