#define WATER_SENSOR_PIN 4  // พินเซนเซอร์น้ำ (ต่อขา DO)
#define BUZZER_PIN 7        // พินออด
#define BUTTON_PIN 5        // พินปุ่มกด (อีกขาต่อลง GND)

bool isMuted = false;       // ตัวแปรเก็บสถานะว่าถูกกดปิดเสียงอยู่หรือไม่

void setup() {
  Serial.begin(9600);       // เปิดใช้งาน Serial Monitor
  
  pinMode(WATER_SENSOR_PIN, INPUT_PULLUP); // เซนเซอร์น้ำแบบ Pull-up
  pinMode(BUZZER_PIN, OUTPUT);             // ออดเป็น Output
  pinMode(BUTTON_PIN, INPUT_PULLUP);       // ปุ่มกดแบบ Pull-up (กดแล้วเป็น LOW)
}

void loop() {
  int waterStatus = digitalRead(WATER_SENSOR_PIN);
  int buttonStatus = digitalRead(BUTTON_PIN);

  // แสดงค่าที่อ่านได้ลงใน Serial Monitor
  Serial.print("Sensor: ");
  Serial.print(waterStatus);
  Serial.print(" | Button: ");
  Serial.println(buttonStatus);

  // ถ้ามีการกดปุ่ม (ค่าเป็น LOW เพราะใช้ INPUT_PULLUP) ให้ทำการรีเซ็ตสถานะเงียบ
  if (buttonStatus == LOW) {
    isMuted = true;
    Serial.println("-> กดปุ่ม: ปิดเสียงชั่วคราว");
    delay(200); // กันสัญญาณรบกวนเวลา press debounce
  }

  // ถ้าเซนเซอร์แห้ง (ไม่มีน้ำ) ให้รีเซ็ตค่า isMuted กลับเป็น false เพื่อรอเตือนรอบใหม่
  if (waterStatus == HIGH) {
    isMuted = false;
  }

  // เงื่อนไขการทำงานของออด
  // ต้องตรวจพบน้ำ (LOW) และยังไม่ได้กดปิดเสียง (!isMuted)
  if (waterStatus == LOW && !isMuted) {     
    tone(BUZZER_PIN, 1000);  // ส่งเสียงเตือน
  } else {
    noTone(BUZZER_PIN);      // หยุดส่งเสียง (ถ้าน้ำแห้ง หรือ กดปุ่มปิดเสียงแล้ว)
  }

  delay(100);  
}
